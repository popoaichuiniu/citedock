{
  "name": "citedock",
  "version": "0.1.0",
  "private": true,
  "description": "Local knowledge tools for AI agents: MCP, document CRUD, PDF citations, Qdrant, and Qwen3 embeddings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popoaichuiniu/citedock.git"
  },
  "homepage": "https://github.com/popoaichuiniu/citedock#readme",
  "bugs": {
    "url": "https://github.com/popoaichuiniu/citedock/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "pretest": "npm run build",
    "test:live": "node --import tsx --test test/live.integration.ts",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write src web test examples README.md package.json tsconfig*.json",
    "start": "node dist/http.js",
    "dev": "tsc -p tsconfig.web.json && tsx watch src/http.ts",
    "mcp": "node dist/mcp.js",
    "rag": "tsx src/cli.ts",
    "qdrant": "bash scripts/qdrant-local.sh",
    "mlx": "bash scripts/mlx-local.sh",
    "test:mlx": ".local/mlx-venv/bin/python -m unittest discover -s test -p '*_test.py'"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@qdrant/js-client-rest": "1.19.0",
    "dotenv": "^18.0.5",
    "pdfjs-dist": "6.4.299",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "7.30.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "rag",
    "qdrant",
    "qwen3",
    "mlx",
    "typescript",
    "knowledge-base",
    "semantic-search",
    "pdf",
    "ai-agents",
    "local-first"
  ]
}
