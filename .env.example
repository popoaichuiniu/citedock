# .env is loaded from the project root, including when spawned from another cwd.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=120000
# openai: use an OpenAI-compatible /v1 base URL (e.g. vLLM).
EMBEDDING_API_KEY=
QUERY_INSTRUCTION=Given a question, retrieve relevant passages that answer the question
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_qwen3_06b
QDRANT_TIMEOUT_MS=30000
# Chunk sizes count Unicode code points, not tokens.
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Optional local bearer token. Required for non-loopback HTTP_HOST.
RAG_API_KEY=
