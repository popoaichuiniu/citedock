# .env is loaded from the project root, including when spawned from another cwd.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_MODEL=mlx-community/Qwen3-Embedding-8B-4bit-DWQ
EMBEDDING_DIMENSIONS=4096
EMBEDDING_BATCH_SIZE=4
EMBEDDING_TIMEOUT_MS=180000
# npm run mlx exposes an OpenAI-compatible /v1/embeddings endpoint.
EMBEDDING_API_KEY=
QUERY_INSTRUCTION=Given a question, retrieve relevant passages that answer the question
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_qwen3_8b_mlx
QDRANT_TIMEOUT_MS=30000
# VS Code launch configurations disable connection reuse for long debugger pauses.
QDRANT_KEEP_ALIVE=true
# Chunk sizes count Unicode code points, not tokens.
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Optional local bearer token. Required for non-loopback HTTP_HOST.
RAG_API_KEY=
